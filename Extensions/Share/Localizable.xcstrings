    "The pictures could not be handed to %@. Open %@ once, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The pictures could not be handed to %1$@. Open %2$@ once, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido pasar las imágenes a %1$@. Abre %2$@ una vez y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images n’ont pas pu être transmises à %1$@. Ouvrez %2$@ une fois, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を%1$@に渡せませんでした。%2$@を一度開いてから、もう一度試してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将图片交给 %1$@。请先打开一次 %2$@，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將圖片交給 %1$@。請先打開 %2$@ 一次，然後再試一次。"
          }
        }
      }
    },
    "There is no picture here. %@ takes pictures to mark up or pin." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hay ninguna imagen. %@ acepta imágenes para marcar o fijar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a aucune image ici. %@ accepte des images à annoter ou à épingler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここには画像がありません。%@は、注釈を付けたりピン留めしたりする画像を受け取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里没有图片。%@ 接收图片用于标注或贴图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡沒有圖片。%@ 接收要標註或釘選的圖片。"
          }
        }
      }
    },
    "^[%lld picture](inflect: true) to mark up in the editor or keep on screen." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld imagen](inflect: true) para marcar en el editor o mantener en pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld image](inflect: true) à annoter dans l’éditeur ou à garder à l’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタで注釈を付けたり画面に表示しておいたりする画像：%lld枚"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 张图片，可在编辑器中标注或保留在屏幕上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 張圖片，可在編輯器中標註或保留在螢幕上。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
