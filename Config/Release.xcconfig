#include "Base.xcconfig"

// The website transports the signed GitHub appcast without changing its bytes (Docs/release.md). "/$()/" keeps "//" from starting a comment.
OMS_UPDATE_FEED_URL = https:/$()/www.ohmyshot.org/updates/appcast

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
