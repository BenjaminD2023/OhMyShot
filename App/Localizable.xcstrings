    "Drag over a formula on screen to copy it as LaTeX. The LaTeX is passed to the next action. Needs the Math Formulas model pack." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra sobre una fórmula de la pantalla para copiarla como LaTeX. El LaTeX pasa a la siguiente acción. Necesita el paquete de modelos “Fórmulas matemáticas”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le pointeur sur une formule à l’écran pour la copier en LaTeX. Le LaTeX est transmis à l’action suivante. Nécessite le pack de modèles Formules mathématiques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上の数式をドラッグして選択すると、LaTeXとしてコピーされます。LaTeXは次のアクションに渡されます。「数式」モデルパックが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在屏幕上拖过公式，将其拷贝为 LaTeX。LaTeX 会传递给下一个操作。需要“数学公式”模型包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在螢幕上拖移選取公式，將其拷貝為 LaTeX。LaTeX 會傳遞給下一個動作。需要「數學公式」模型套件。"
          }
        }
      }
    },
    "Drag over text on screen to copy it. The text is passed to the next action." : {
