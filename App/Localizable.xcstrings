{
  "sourceLanguage" : "en",
  "strings" : {
    "${operation} desktop icons" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${operation} los iconos del escritorio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${operation} les icônes du bureau"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップアイコンを${operation}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${operation}桌面图标"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${operation}桌面圖像"
          }
        }
      }
    },
    "%@ couldn’t read it, so this Mac’s reading was copied: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn’t read it, so this Mac’s reading was copied: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no ha podido leerla, así que se ha copiado lo leído en este Mac: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas pu la lire ; le texte lu sur ce Mac a été copié : %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で読み取れなかったため、このMacで読み取ったテキストをコピーしました：%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 读取失败，已拷贝这台 Mac 读取的文字：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 讀取失敗，已拷貝這台 Mac 讀取的文字：%2$@"
          }
        }
      }
    },
    "%@ found no text, so this Mac’s reading was copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha encontrado texto, así que se ha copiado lo leído en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a trouvé aucun texte ; le texte lu sur ce Mac a été copié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はテキストを見つけられなかったため、このMacで読み取ったテキストをコピーしました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有找到文字，已拷贝这台 Mac 读取的文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有找到文字，已拷貝這台 Mac 讀取的文字。"
          }
        }
      }
    },
    "%@ gave an address that deletes the file when it’s opened. It opens in your browser, and the upload is taken off this list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha dado una dirección que elimina el archivo al abrirla. Se abrirá en tu navegador y la subida se quitará de esta lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a fourni une adresse qui supprime le fichier lorsqu’elle est ouverte. Elle s’ouvre dans votre navigateur, et le téléversement est retiré de cette liste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@から返されたアドレスは、開くとファイルが削除されるものです。ブラウザで開き、このアップロードはリストから取り除かれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 给出的地址在打开时会删除该文件。它将在浏览器中打开，此上传项也会从列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 提供的位址會在開啟時刪除檔案。它會在你的瀏覽器中打開，且此上傳項目會從列表中移除。"
          }
        }
      }
    },
    "%@ took too long, so this Mac’s reading was copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha tardado demasiado, así que se ha copiado lo leído en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a mis trop de temps ; le texte lu sur ce Mac a été copié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の読み取りに時間がかかりすぎたため、このMacで読み取ったテキストをコピーしました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 耗时太久，已拷贝这台 Mac 读取的文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 耗時太久，已拷貝這台 Mac 讀取的文字。"
          }
        }
      }
    },
    "A script wants to control OhMyShot" : {
