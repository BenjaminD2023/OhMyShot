    "Capture the area chosen last again, as it is on screen now. The screenshot is passed to the next action." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a capturar el área elegida la última vez, tal como se ve ahora en pantalla. La captura pasa a la siguiente acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturer à nouveau la dernière zone choisie, telle qu’elle est à l’écran maintenant. La capture d’écran est transmise à l’action suivante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回選択した範囲を、現在の画面の状態でもう一度キャプチャします。スクリーンショットは次のアクションに渡されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按屏幕当前内容，再次截取上次选择的区域。截图会传递给下一个操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次擷取上次選擇的區域，以其目前在螢幕上的樣子。截圖會傳遞給下一個動作。"
          }
        }
      }
    },
