    },
    "OhMyShot needs Screen Recording permission. Turn it on in System Settings › Privacy & Security, then try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OhMyShot necesita el permiso de Grabación de pantalla. Actívalo en Ajustes del Sistema › Privacidad y seguridad y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OhMyShot a besoin de l’autorisation Enregistrement de l’écran. Activez-la dans Réglages Système › Confidentialité et sécurité, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OhMyShotには画面収録の許可が必要です。「システム設定」›「プライバシーとセキュリティ」でオンにしてから、もう一度試してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OhMyShot 需要“录屏与系统录音”权限。请在“系统设置 › 隐私与安全性”中打开，然后重试。"
          }
        },
        "zh-Hant" : {
