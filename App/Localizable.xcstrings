    "It will be able to take screenshots and open files in OhMyShot. You can remove its access later in Settings › Automation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrá hacer capturas de pantalla y abrir archivos en OhMyShot. Puedes retirarle el acceso más tarde en Ajustes › Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pourra prendre des captures d’écran et ouvrir des fichiers dans OhMyShot. Vous pourrez lui retirer cet accès plus tard dans Réglages › Automatisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OhMyShotでスクリーンショットを撮ったりファイルを開いたりできるようになります。あとで「設定」›「自動化」でアクセスを取り消せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它将能够截图并在 OhMyShot 中打开文件。你之后可以在“设置 › 自动化”中移除它的访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它將能夠截圖並在 OhMyShot 中打開檔案。你之後可以在「設定」›「自動化」中移除其權限。"
          }
        }
      }
