    "Auto-scroll needs Accessibility. The area is kept for the next Scrolling Capture." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento automático necesita Accesibilidad. El área se guarda para la próxima captura con desplazamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement automatique a besoin de l’Accessibilité. La zone est gardée pour la prochaine capture défilante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スクロールにはアクセシビリティが必要です。この範囲は次のスクロールキャプチャで使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动滚动需要辅助功能权限。下次滚动截图时会沿用这个区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動捲動需要輔助使用權限。下次捲動擷取時會沿用這個區域。"
          }
        }
      }
    },
    "Auto-scroll needs Accessibility. Turn it on in System Settings › Privacy & Security, then start the scrolling capture again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento automático necesita Accesibilidad. Actívalo en Ajustes del Sistema › Privacidad y seguridad y vuelve a iniciar la captura con desplazamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement automatique nécessite l’accès Accessibilité. Activez-le dans Réglages Système › Confidentialité et sécurité, puis relancez la capture défilante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スクロールにはアクセシビリティが必要です。「システム設定」›「プライバシーとセキュリティ」でオンにしてから、スクロールキャプチャをもう一度開始してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动滚动需要“辅助功能”权限。请在“系统设置 › 隐私与安全性”中打开，然后重新开始滚动截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動捲動需要「輔助使用」權限。請在「系統設定」›「隱私權與安全性」中開啟，然後重新開始捲動擷取。"
          }
        }
      }
    },
