    "That destination was removed, so the file can’t be deleted from here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese destino se ha eliminado, así que el archivo no se puede eliminar desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette destination a été supprimée ; le fichier ne peut donc pas être supprimé d’ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアップロード先は削除されたため、ここからファイルを削除できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该上传目标已被移除，因此无法从这里删除文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該目的地已被移除，因此無法從這裡刪除檔案。"
          }
        }
      }
    },
    "That destination was removed. Choose Upload again to pick another." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese destino se ha eliminado. Elige “Subir” de nuevo para elegir otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette destination a été supprimée. Choisissez à nouveau Téléverser pour en choisir une autre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアップロード先は削除されました。もう一度「アップロード」を選択して、別のアップロード先を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该上传目标已被移除。请再次选择“上传”以选取其他目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該目的地已被移除。請再次選擇「上傳」以挑選另一個。"
          }
        }
      }
    },
    "The capture couldn’t be kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conservar la captura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de conserver la capture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャを保存できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保留该截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法保留擷取內容。"
          }
        }
      }
    },
    "The file is removed from the storage, and its link stops working. This can’t be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se elimina del almacenamiento y su enlace deja de funcionar. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est supprimé du stockage et son lien cesse de fonctionner. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはストレージから削除され、リンクは機能しなくなります。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件将从存储中移除，其链接也将失效。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案會從儲存空間中移除，其連結也會失效。此動作無法還原。"
          }
        }
      }
    },
