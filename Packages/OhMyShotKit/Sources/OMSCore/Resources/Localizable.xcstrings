    "{%@} reads the server’s answer, so it only works in the link, thumbnail, deletion and error templates." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{%@} lee la respuesta del servidor, así que solo funciona en las plantillas de enlace, miniatura, eliminación y error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{%@} lit la réponse du serveur ; il ne fonctionne donc que dans les modèles de lien, de vignette, de suppression et d’erreur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{%@}はサーバの応答を読み取るため、リンク、サムネール、削除、エラーの各テンプレートでのみ使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{%@} 读取服务器的响应，因此只能用于链接、缩略图、删除和错误模板中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{%@} 會讀取伺服器的回應，因此只能用於連結、縮覽圖、刪除和錯誤範本中。"
          }
        }
      }
    },
