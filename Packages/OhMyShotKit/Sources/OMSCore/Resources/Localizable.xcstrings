          }
        }
      }
    },
    "The uploader sends its request as %@, which doesn’t carry a file. OhMyShot supports MultipartFormData and Binary." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uploader envía su solicitud como %@, que no transporta archivos. OhMyShot admite MultipartFormData y Binary."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le module de téléversement envoie sa requête en %@, ce qui ne permet pas de transmettre un fichier. OhMyShot prend en charge MultipartFormData et Binary."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップローダはリクエストを%@として送信しますが、この形式ではファイルを送れません。OhMyShotはMultipartFormDataとBinaryをサポートしています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该上传器以 %@ 方式发送请求，无法携带文件。OhMyShot 支持 MultipartFormData 和 Binary。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此上傳器以 %@ 傳送請求，無法攜帶檔案。OhMyShot 支援 MultipartFormData 和 Binary。"
          }
        }
      }
    },
    "The uploader sends with %@, which can’t carry a file. OhMyShot supports POST, PUT and PATCH." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uploader envía con %@, que no puede transportar archivos. OhMyShot admite POST, PUT y PATCH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le module de téléversement utilise %@, qui ne permet pas de transmettre un fichier. OhMyShot prend en charge POST, PUT et PATCH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップローダは%@で送信しますが、この方式ではファイルを送れません。OhMyShotはPOST、PUT、PATCHをサポートしています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
