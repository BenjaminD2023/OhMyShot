          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le module de téléversement envoie un formulaire mais n’indique pas dans quel champ placer le fichier (FileFormName)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップローダはフォームを送信しますが、ファイルを入れるフィールド（FileFormName）が指定されていません。"
