    "The JSON path “%@” uses a form OhMyShot doesn’t support; only names, [0] indexes and ['name'] keys are." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta JSON “%@” usa una forma que OhMyShot no admite; solo se admiten nombres, índices [0] y claves ['name']."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chemin JSON « %@ » utilise une forme qu’OhMyShot ne prend pas en charge ; seuls les noms, les index [0] et les clés ['nom'] le sont."
