        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le module de téléversement utilise l’ancien type de réponse « Headers » de ShareX, que ShareX lui-même ne prend plus en charge. Utilisez plutôt {header:nom} dans son URL."
          }
