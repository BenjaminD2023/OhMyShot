    "The model answered, but not with the words in the picture: “%@”. Check that it reads pictures." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo ha respondido, pero no con las palabras de la imagen: «%@». Comprueba que lee imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle a répondu, mais pas avec les mots de l’image : « %@ ». Vérifiez qu’il lit les images."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルは応答しましたが、画像の語句ではありませんでした：「%@」。画像を読み取れるモデルか確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型回答了，但不是图片中的词：“%@”。请确认它能读取图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
