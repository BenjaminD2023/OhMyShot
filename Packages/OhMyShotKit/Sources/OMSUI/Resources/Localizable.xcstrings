      }
    },
    "Sets the default for new Recognized Text windows. You can change wrapping in each window without changing this setting. Wrapping only changes the display." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define si las nuevas ventanas Texto reconocido ajustan el texto a su ancho. Puedes cambiarlo en cada ventana sin modificar esta opción. Ajustar el texto solo cambia cómo se muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit si les nouvelles fenêtres Texte reconnu ajustent le texte à leur largeur. Vous pouvez le changer dans chaque fenêtre sans modifier ce réglage. Le renvoi à la ligne ne change que l’affichage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく開く「認識されたテキスト」ウインドウで折り返すかどうかを設定します。この設定を変えずに、ウインドウごとに切り替えることもできます。折り返しは表示だけを変えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定新打开的“识别的文字”窗口是否自动换行。每个窗口都可以单独切换，不会改动这项设置。换行只影响显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定新開啟的「辨識出的文字」視窗是否自動換行。每個視窗都可以單獨切換，不會更動這項設定。換行只影響顯示。"
          }
        }
      }
    },
