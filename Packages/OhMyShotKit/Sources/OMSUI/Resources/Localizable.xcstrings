          }
        }
      }
    },
    "The name of a model that reads pictures, as the service lists it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de un modelo que lea imágenes, tal como lo indica el servicio."
          }
