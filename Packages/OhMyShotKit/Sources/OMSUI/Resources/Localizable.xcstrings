    "Video or GIF, computer audio, the microphone, clicks, and keystrokes are chosen on the bar under what you are about to record." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo o GIF, el audio del ordenador, el micrófono, los clics y las pulsaciones de teclas se eligen en la barra que aparece bajo lo que vas a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo ou GIF, l’audio de l’ordinateur, le micro, les clics et les touches se choisissent dans la barre située sous ce que vous allez enregistrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオかGIFか、コンピュータのオーディオ、マイク、クリック、キー操作は、収録しようとしているものの下のバーで選択します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频或 GIF、电脑音频、麦克风、点按和按键，都在即将录制的内容下方的录制栏中选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片或 GIF、電腦音訊、麥克風、點按和按鍵，都在即將錄製內容下方的工具列上選擇。"
          }
        }
      }
    },
