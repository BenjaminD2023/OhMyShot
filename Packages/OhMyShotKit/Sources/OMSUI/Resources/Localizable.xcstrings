    "Add storage you own, such as an S3 bucket, a WebDAV folder, or your own server. Captures go from this Mac straight to it; OhMyShot has no server of its own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un almacenamiento propio, como un bucket de S3, una carpeta WebDAV o tu propio servidor. Las capturas van directamente de este Mac a él; OhMyShot no tiene servidor propio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un stockage qui vous appartient, comme un compartiment S3, un dossier WebDAV ou votre propre serveur. Les captures vont directement de ce Mac vers celui-ci ; OhMyShot n’a pas de serveur à lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S3バケット、WebDAVフォルダ、独自のサーバなど、自分が所有するストレージを追加します。キャプチャはこのMacから直接送信されます。OhMyShot独自のサーバはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加你自己的存储，例如 S3 存储桶、WebDAV 文件夹或你自己的服务器。截图会从这台 Mac 直接发送到那里；OhMyShot 没有自己的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入你自己擁有的儲存空間，例如 S3 儲存桶、WebDAV 檔案夾或你自己的伺服器。擷取內容會從這台 Mac 直接傳送到該處；OhMyShot 本身沒有任何伺服器。"
          }
        }
      }
