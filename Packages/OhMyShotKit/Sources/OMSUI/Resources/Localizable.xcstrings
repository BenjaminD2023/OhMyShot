          }
        }
      }
    },
    "Choose All to see every capture in the history." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige “Todo” para ver todas las capturas del historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Tout pour voir toutes les captures de l’historique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴内のすべてのキャプチャを表示するには、「すべて」を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“全部”以查看历史记录中的所有截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「全部」以查看記錄中的每個擷取內容。"
          }
        }
      }
    },
    "Choose GIF on the recording bar to keep a recording as an animated GIF, which shows wherever pictures do. GIFs have no sound and are made as large as things were on screen, at most 1920 pixels on their longer side. More frames move more smoothly and make larger files." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige GIF en la barra de grabación para conservar una grabación como GIF animado, que se ve en cualquier sitio donde se vean imágenes. Los GIF no tienen sonido y se crean al tamaño que tenían las cosas en pantalla, con un máximo de 1920 píxeles en su lado más largo. Más fotogramas dan un movimiento más fluido y archivos más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez GIF dans la barre d’enregistrement pour conserver un enregistrement sous forme de GIF animé, qui s’affiche partout où les images s’affichent. Les GIF n’ont pas de son et sont créés à la taille qu’avaient les éléments à l’écran, avec au plus 1920 pixels sur leur plus grand côté. Davantage d’images par seconde donnent un mouvement plus fluide et des fichiers plus volumineux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録バーで「GIF」を選択すると、収録をアニメーションGIFとして保存できます。GIFは画像を表示できる場所ならどこでも表示されます。GIFにはサウンドがなく、画面上と同じ大きさ（長辺は最大1920ピクセル）で作成されます。フレーム数が多いほど動きがなめらかになり、ファイルサイズが大きくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在录制栏中选择“GIF”可将录制保留为动态 GIF，在任何能显示图片的地方都能播放。GIF 没有声音，尺寸与屏幕上的原始大小相同，长边最多 1920 像素。帧数越多，动画越流畅，文件也越大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在錄製工具列上選擇「GIF」可將錄影保留為 GIF 動畫，任何可顯示圖片的地方都能播放。GIF 沒有聲音，大小與螢幕上的顯示大小相同，長邊最多 1920 像素。影格越多動作越流暢，但檔案也越大。"
          }
        }
      }
    },
    "Choose a ShareX custom uploader file (.sxcu)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo de uploader personalizado de ShareX (.sxcu)."
