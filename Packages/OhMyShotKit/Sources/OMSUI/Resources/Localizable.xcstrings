    "An optional canned ACL sent with each file, such as public-read. Leave it empty for Cloudflare R2, which refuses ACLs, and for buckets with a public policy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ACL predefinida opcional que se envía con cada archivo, como public-read. Déjala vacía para Cloudflare R2, que rechaza las ACL, y para buckets con una política pública."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ACL prédéfinie facultative envoyée avec chaque fichier, par exemple public-read. Laissez ce champ vide pour Cloudflare R2, qui refuse les ACL, et pour les compartiments dotés d’une stratégie publique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ファイルとともに送信する既定ACL（public-readなど）。省略可能です。ACLを受け付けないCloudflare R2や、公開ポリシーが設定されたバケットでは空のままにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选的预设 ACL，随每个文件一起发送，例如 public-read。对于拒绝 ACL 的 Cloudflare R2 以及使用公开策略的存储桶，请留空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨每個檔案傳送的選用預設 ACL，例如 public-read。若使用 Cloudflare R2（會拒絕 ACL）或具有公開政策的儲存桶，請留空。"
          }
        }
      }
    },
