          }
        }
      }
    },
    "The address of the S3 service, without the bucket. Cloudflare R2, MinIO, Backblaze B2, Wasabi, and other S3-compatible services each give you one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
