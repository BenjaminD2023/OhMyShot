    "A wide-gamut display captures in Display P3. Converting makes colors look the same in apps that ignore color profiles." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pantalla de gama amplia captura en Display P3. Al convertir, los colores se ven igual en las apps que ignoran los perfiles de color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un écran à large gamme capture en Display P3. La conversion donne les mêmes couleurs dans les apps qui ignorent les profils colorimétriques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広色域ディスプレイではDisplay P3でキャプチャされます。変換すると、カラープロファイルを無視するアプリでも同じ色に見えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "广色域显示器以 Display P3 截图。转换后，颜色在忽略颜色描述文件的 App 中看起来也一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "廣色域顯示器以 Display P3 擷取。轉換後，在忽略色彩描述檔的 App 中顏色看起來也會相同。"
          }
        }
      }
    },
