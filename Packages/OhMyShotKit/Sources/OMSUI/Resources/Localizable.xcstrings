    "Optional. Shown when the server answers with an error, so a failed upload says why." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Se muestra cuando el servidor responde con un error, para que una subida fallida indique el motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Affiché lorsque le serveur répond par une erreur, pour qu’un téléversement échoué en indique la raison."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
