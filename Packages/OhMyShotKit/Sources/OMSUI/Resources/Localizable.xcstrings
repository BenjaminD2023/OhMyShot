        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses %@ sont supprimés de ce Mac. Les tableaux et graphiques sont lus comme du texte simple jusqu’à ce qu’il soit de nouveau téléchargé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacから%@が削除されます。再度ダウンロードするまで、表やグラフは通常のテキストとして読み取られます。"
