    },
    "The new language shows after OhMyShot relaunches." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo idioma aparecerá cuando OhMyShot se vuelva a abrir."
          }
        },
