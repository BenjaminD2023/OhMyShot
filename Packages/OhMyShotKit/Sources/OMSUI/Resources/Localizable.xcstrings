    "Captures are found by the words in them and the app they were taken in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas se encuentran por las palabras que contienen y por la app en la que se hicieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures sont retrouvées par les mots qu’elles contiennent et par l’app dans laquelle elles ont été prises."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャは、含まれている語句や撮影したアプリで検索できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可按截图中的文字和截图时所在的 App 查找截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可依擷取內容中的文字及擷取時所在的 App 搜尋。"
          }
        }
      }
    },
    "Captures go only to History." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas solo van al historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures vont uniquement dans l’historique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャは履歴にのみ保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图仅保存到历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取內容只會進入記錄。"
          }
        }
      }
    },
    "Captures older than %@ are deleted now. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas de más de %@ se eliminarán ahora. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de plus de %@ sont supprimées maintenant. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@より古いキャプチャは今すぐ削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早于%@的截图将立即删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早於 %@ 的擷取內容將立即刪除。此動作無法還原。"
          }
        }
      }
    },
    "Captures stay here for %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas se quedan aquí durante %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures restent ici pendant %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャはここに%@保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图在此保留%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取內容會在此保留 %@。"
          }
        }
      }
    },
    "Captures won’t be kept anywhere." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas no se conservarán en ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures ne seront conservées nulle part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャはどこにも保存されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图不会保存到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取內容不會保留在任何地方。"
          }
        }
      }
    },
    "Cards stand on the display the capture was taken on. With this on they stand on the display where the pointer is when the capture is taken." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas aparecen en la pantalla en la que se hizo la captura. Con esta opción activada, aparecen en la pantalla en la que está el puntero al hacer la captura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes s’affichent sur l’écran où la capture a été prise. Avec cette option, elles s’affichent sur l’écran où se trouve le pointeur au moment de la capture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードは、キャプチャを撮影したディスプレイに表示されます。オンにすると、撮影時にポインタがあるディスプレイに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片显示在截图所在的显示器上。打开此项后，卡片会显示在截图时指针所在的显示器上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片會顯示在擷取時所在的顯示器上。開啟此選項後，卡片會顯示在擷取時指標所在的顯示器上。"
          }
        }
      }
    },
    "Checked before it’s used and kept on this Mac; nothing you capture is sent. Remove it any time in Settings › Tools." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comprueba antes de usarse y se guarda en este Mac; no se envía nada de lo que capturas. Puedes eliminarlo cuando quieras en Ajustes › Herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifié avant d’être utilisé et conservé sur ce Mac ; rien de ce que vous capturez n’est envoyé. Supprimez-le à tout moment dans Réglages › Outils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用前に検証され、このMacに保存されます。キャプチャした内容が送信されることはありません。「設定」›「ツール」でいつでも削除できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用前会先校验，并保存在这台 Mac 上；你截取的任何内容都不会被发送。随时可以在“设置 › 工具”中移除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用前會先檢查，並保存在這台 Mac 上；你擷取的任何內容都不會被傳送。隨時可以在「設定」›「工具」中移除它。"
          }
        }
      }
    },
    "Choose" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir"
          }
        },
