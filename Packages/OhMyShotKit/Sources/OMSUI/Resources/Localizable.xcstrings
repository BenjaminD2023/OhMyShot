    "Sends a small picture of the words “%@” to the service and checks that the model reads them back. The service may charge for it, as for any request." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía al servicio una imagen pequeña con las palabras «%@» y comprueba que el modelo las lee. El servicio puede cobrar por ello, como por cualquier solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie au service une petite image des mots « %@ » et vérifie que le modèle les relit. Le service peut la facturer, comme toute requête."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」と書かれた小さな画像をサービスに送り、モデルがそれを読み返せるか確認します。ほかのリクエストと同様に料金がかかる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向服务发送一张写着“%@”的小图片，并检查模型能否读回这些词。和任何请求一样，服务可能会为此收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向服務傳送一張寫著「%@」的小圖片，並檢查模型能否讀回這些字。和任何請求一樣，服務可能會為此收費。"
          }
        }
      }
    },
    "Sends this picture to %@" : {
      "localizations" : {
