    "Its %@ are deleted from this Mac. Capture Formula is unavailable until it’s downloaded again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan sus %@ de este Mac. Capturar fórmula no estará disponible hasta que lo vuelvas a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses %@ sont supprimés de ce Mac. Capturer une formule est indisponible jusqu’à ce qu’il soit de nouveau téléchargé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacから%@が削除されます。再度ダウンロードするまで、「数式をキャプチャ」は使えません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它占用的 %@ 将从这台 Mac 上删除。重新下载之前，无法使用“截取公式”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它佔用的 %@ 將從這台 Mac 上刪除。重新下載之前，無法使用「擷取公式」。"
          }
        }
      }
    },
    "Its %@ are deleted from this Mac. Tables and charts are read as plain text until it’s downloaded again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan sus %@ de este Mac. Las tablas y los gráficos se leerán como texto normal hasta que lo vuelvas a descargar."
          }
