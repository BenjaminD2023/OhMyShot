          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse du service S3, sans le compartiment. Cloudflare R2, MinIO, Backblaze B2, Wasabi et les autres services compatibles S3 vous en fournissent chacun une."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
