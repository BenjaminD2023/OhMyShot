    "%@ read the test picture in %@ s." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ read the test picture in %2$@ s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha leído la imagen de prueba en %2$@ s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a lu l’image de test en %2$@ s."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がテスト画像を%2$@秒で読み取りました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 用 %2$@ 秒读出了测试图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 用 %2$@ 秒讀出了測試圖片。"
          }
        }
      }
    },
    "%@ reads it there, with %@. The picture leaves this Mac each time you choose Read with %@; your API key stays in the Keychain." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ reads it there, with %2$@. The picture leaves this Mac each time you choose Read with %3$@; your API key stays in the Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ la lee allí, con %2$@. La imagen sale de este Mac cada vez que eliges Leer con %3$@; tu clave de API se queda en el Llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ la lit là-bas, avec %2$@. L’image quitte ce Mac chaque fois que vous choisissez Lire avec %3$@ ; votre clé d’API reste dans le trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がそこで%2$@を使って読み取ります。「%3$@で読み取る」を選ぶたびに画像はこのMacから送信されます。APIキーはキーチェーンに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会在那里用 %2$@ 读取它。每次选择“用 %3$@ 读取”，图片都会离开这台 Mac；你的 API 密钥保留在钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 會在那裡以 %2$@ 讀取它。每次選擇「用 %3$@ 讀取」，圖片都會離開這台 Mac；你的 API 密鑰保留在鑰匙圈中。"
          }
        }
      }
    },
