    "Desktop wallpaper" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo de escritorio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fond d’écran du bureau"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップの壁紙"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌面墙纸"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌面背景"
          }
        }
      }
    },
    "Desktop wallpaper puts a window on the desktop picture around it, as the screen shows it. Hold Shift as you click a window to take it the other way: with no background, or on the desktop wallpaper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Fondo de escritorio” coloca una ventana sobre la imagen de escritorio que la rodea, tal como se ve en pantalla. Mantén pulsada Mayúsculas al hacer clic en una ventana para capturarla de la otra forma: sin fondo o sobre el fondo de escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fond d’écran du bureau place une fenêtre sur l’image du bureau qui l’entoure, telle que l’écran l’affiche. Maintenez Maj enfoncée en cliquant sur une fenêtre pour la capturer de l’autre façon : sans arrière-plan, ou sur le fond d’écran du bureau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デスクトップの壁紙」では、画面に表示されているとおり、ウインドウの周囲にデスクトップピクチャを付けます。shiftキーを押しながらウインドウをクリックすると、もう一方の方法（背景なし、またはデスクトップの壁紙付き）でキャプチャします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“桌面墙纸”会将窗口放在其周围的桌面图片上，与屏幕显示的一样。点按窗口时按住 Shift 键可采用另一种方式：无背景，或放在桌面墙纸上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「桌面背景」會將視窗放在其周圍的桌面圖片上，如同螢幕上所見。按一下視窗時按住 Shift 可採用另一種方式：無背景，或放在桌面背景上。"
          }
        }
      }
    },
