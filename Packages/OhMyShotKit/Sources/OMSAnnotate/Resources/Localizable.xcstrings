    "%lld pt, for strokes drawn freely (hold Command). Over text, a highlight is as tall as the letters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pt, para trazos libres (mantén pulsada la tecla Comando). Sobre texto, el resaltado tiene la altura de las letras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pt, pour les traits libres (maintenez Commande). Sur du texte, le surlignage a la hauteur des lettres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldポイント、自由に描くストローク用（commandキーを押したまま）。テキストの上では、ハイライトは文字の高さになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 点，用于自由绘制的笔画（按住 Command）。在文字上，高亮与字母等高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 點，用於自由繪製的筆畫（按住 Command）。在文字上，螢光標記與字母等高。"
          }
        }
      }
    },
