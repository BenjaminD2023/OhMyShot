    "Start recording (Return)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar a grabar (Retorno)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancer l’enregistrement (Retour)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録を開始（return）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始录制（返回）"
          }
        },
