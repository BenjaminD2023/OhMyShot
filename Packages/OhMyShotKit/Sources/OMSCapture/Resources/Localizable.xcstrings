    "Scroll what is under the area to capture it. Click Done when you have all of it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza lo que hay bajo el área para capturarlo. Haz clic en OK cuando lo tengas todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler ce qui se trouve sous la zone pour le capturer. Cliquez sur Terminé lorsque vous avez tout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲の下にある内容をスクロールしてキャプチャします。すべてキャプチャできたら「完了」をクリックしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
