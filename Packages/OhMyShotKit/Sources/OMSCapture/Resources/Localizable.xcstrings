    "Auto-scroll couldn’t start for this window. You can still scroll by hand." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido iniciar el desplazamiento automático en esta ventana. Aún puedes desplazarte a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement automatique n’a pas pu démarrer pour cette fenêtre. Vous pouvez toujours faire défiler manuellement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウでは自動スクロールを開始できませんでした。手動でスクロールすることはできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法为此窗口开始自动滚动。你仍可以手动滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法對此視窗開始自動捲動。你仍可手動捲動。"
          }
        }
      }
    },
    "Auto-scroll needs Accessibility. Turn it on in System Settings › Privacy & Security." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento automático necesita Accesibilidad. Actívalo en Ajustes del Sistema › Privacidad y seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement automatique nécessite l’accès Accessibilité. Activez-le dans Réglages Système › Confidentialité et sécurité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スクロールにはアクセシビリティが必要です。「システム設定」›「プライバシーとセキュリティ」でオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动滚动需要“辅助功能”权限。请在“系统设置 › 隐私与安全性”中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動捲動需要「輔助使用」權限。請在「系統設定」›「隱私權與安全性」中開啟。"
          }
        }
      }
    },
    "Auto-scroll stopped: nothing more came into view. Click Done, or scroll on by hand." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento automático se ha detenido: no aparece nada más. Haz clic en OK o sigue desplazándote a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défilement automatique arrêté : plus rien de nouveau n’apparaît. Cliquez sur Terminé, ou continuez à faire défiler manuellement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スクロールが停止しました：新しい内容が表示されなくなりました。「完了」をクリックするか、手動でスクロールを続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动滚动已停止：没有更多内容出现。请点按“完成”，或继续手动滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動捲動已停止：沒有更多內容出現。請按一下「完成」，或繼續手動捲動。"
          }
        }
      }
    },
    "Auto-scroll stopped: the target app closed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento automático se ha detenido: la app de destino se ha cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défilement automatique arrêté : l’app cible a été fermée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スクロールが停止しました：対象のアプリが終了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动滚动已停止：目标 App 已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動捲動已停止：目標 App 已關閉。"
          }
        }
      }
    },
