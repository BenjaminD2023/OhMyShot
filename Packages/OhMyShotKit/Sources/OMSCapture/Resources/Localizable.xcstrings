    "Camera access is off. Turn on OhMyShot in System Settings › Privacy & Security › Camera." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Activa OhMyShot en Ajustes del Sistema › Privacidad y seguridad › Cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la caméra est désactivé. Activez OhMyShot dans Réglages Système › Confidentialité et sécurité › Caméra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフになっています。「システム設定」›「プライバシーとセキュリティ」›「カメラ」でOhMyShotをオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头访问权限已关闭。请在“系统设置 › 隐私与安全性 › 摄像头”中打开 OhMyShot。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機取用權限已關閉。請在「系統設定」›「隱私權與安全性」›「相機」中開啟 OhMyShot。"
          }
        }
      }
    },
    "Camera access is off. Turn on OhMyShot in System Settings, Privacy and Security, Camera." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Activa OhMyShot en Ajustes del Sistema, Privacidad y seguridad, Cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la caméra est désactivé. Activez OhMyShot dans Réglages Système, Confidentialité et sécurité, Caméra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフになっています。システム設定の、プライバシーとセキュリティ、カメラで、OhMyShotをオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头访问权限已关闭。请在系统设置的隐私与安全性中，打开摄像头下的 OhMyShot。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機取用權限已關閉。請在「系統設定」、「隱私權與安全性」、「相機」中開啟 OhMyShot。"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
