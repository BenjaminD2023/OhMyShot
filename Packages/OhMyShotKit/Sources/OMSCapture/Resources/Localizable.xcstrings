    "All-In-One. Drag over an area, then choose what to do with it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo en uno. Arrastra sobre un área y elige qué hacer con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout-en-un. Faites glisser le pointeur sur une zone, puis choisissez quoi en faire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オールインワン。範囲をドラッグして選択し、その範囲に対する操作を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多合一。拖移选择一个区域，然后选择要对它执行的操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多合一。拖移選取一個區域，然後選擇要對它做什麼。"
          }
        }
      }
    },
