            "value" : "文字"
          }
        }
      }
    },
    "Text. Drag over text to copy it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto. Arrastra sobre un texto para copiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte. Faites glisser le pointeur sur du texte pour le copier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト。テキストをドラッグしてコピーします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字。拖过文字以拷贝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字。拖移選取文字以拷貝。"
          }
        }
      }
    },
    "The selection's edges snap to text; hold Command to place them freely." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bordes de la selección se ajustan al texto; mantén pulsada la tecla Comando para colocarlos libremente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bords de la sélection s’alignent sur le texte ; maintenez Commande enfoncée pour les placer librement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択範囲の端はテキストに吸着します。commandキーを押したままにすると自由に配置できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选区边缘会吸附到文字；按住 Command 键可自由放置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取範圍的邊緣會貼齊文字；按住 Command 可自由放置。"
          }
        }
      }
    },
    "The views no longer line up. Let the page settle, or scroll back a little." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las vistas ya no coinciden. Espera a que la página se estabilice o vuelve a desplazarte un poco hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vues ne s’alignent plus. Laissez la page se stabiliser, ou faites défiler un peu en arrière."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示内容がつながらなくなりました。ページが落ち着くまで待つか、少し戻してスクロールしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面已无法对齐。请等待页面稳定，或稍微往回滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫面已無法對齊。請等頁面穩定下來，或稍微往回捲動。"
          }
        }
      }
    },
    "This is as long as a capture can be. Click Done to keep it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la longitud máxima de una captura. Haz clic en OK para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture a atteint sa longueur maximale. Cliquez sur Terminé pour la conserver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャできる長さの上限に達しました。保存するには「完了」をクリックしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图已达最大长度。点按“完成”以保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取內容已達長度上限。請按一下「完成」以保留。"
          }
        }
      }
    },
