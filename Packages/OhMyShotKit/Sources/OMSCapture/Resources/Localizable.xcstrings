    },
    "Start scrolling automatically; adjust the speed in the capture panel" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar a desplazar automáticamente; ajusta la velocidad en el panel de captura"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défiler automatiquement ; réglez la vitesse dans le panneau de capture"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スクロールを開始します。速度はキャプチャパネルで調整できます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始自动滚动；可在截图面板中调整速度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動開始捲動；可在擷取面板中調整速度"
          }
        }
      }
    },
    "Start, then scroll what is under the area (Return)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar y desplazar lo que hay bajo el área (Retorno)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencer, puis faire défiler ce qui se trouve sous la zone (Retour)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始してから範囲の下にある内容をスクロール（return）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始，然后滚动区域下方的内容（返回）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始，然後捲動區域下方的內容（Return）"
          }
        }
      }
    },
