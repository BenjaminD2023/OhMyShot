    "Studio doesn’t add the camera to a window recorded on its own yet" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio todavía no añade la cámara a una ventana grabada por sí sola"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio n’ajoute pas encore la caméra à une fenêtre enregistrée seule"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単独で収録したウインドウには、スタジオはまだカメラ映像を追加できません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio 暂不支持为单独录制的窗口添加摄像头画面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio 目前還無法將相機畫面加入單獨錄製的視窗"
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto"
          }
        },
        "fr" : {
