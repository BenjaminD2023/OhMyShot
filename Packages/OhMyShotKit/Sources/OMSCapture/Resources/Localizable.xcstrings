    "A window is recorded on its own, without keys shown over it" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana se graba por sí sola, sin las teclas mostradas encima"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fenêtre est enregistrée seule, sans les touches affichées par-dessus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウは単独で収録され、キー表示は重ねられません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独录制窗口时，不会在其上方显示按键"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨錄製視窗時，不會在上方顯示按鍵"
          }
        }
      }
    },
    "A window is recorded on its own, without the camera over it" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana se graba por sí sola, sin la cámara encima"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fenêtre est enregistrée seule, sans la caméra par-dessus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウは単独で収録され、カメラ映像は重ねられません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独录制窗口时，不会在其上方显示摄像头画面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨錄製視窗時，不會在上方顯示相機畫面"
          }
        }
      }
    },
    "All-In-One" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo en uno"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout-en-un"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オールインワン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多合一"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多合一"
          }
