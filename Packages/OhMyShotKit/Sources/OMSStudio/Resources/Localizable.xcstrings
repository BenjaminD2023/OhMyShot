    "Blurs the picture while the view zooms or pans, as a camera would. Still frames stay sharp." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoca la imagen mientras la vista hace zoom o se desplaza, como lo haría una cámara. Los fotogramas fijos se mantienen nítidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute l’image pendant que la vue zoome ou se déplace, comme le ferait une caméra. Les plans fixes restent nets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラのように、ズームやパンの間は映像をぼかします。静止したフレームはくっきりしたままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面缩放或平移时像摄像机一样产生模糊。静止画面保持清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在畫面縮放或平移時模糊影像，就像攝影機一樣。靜止畫面會保持清晰。"
          }
        }
      }
    },
