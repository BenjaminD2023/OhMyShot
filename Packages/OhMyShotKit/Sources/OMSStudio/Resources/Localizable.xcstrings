    "A zoom at the playhead, following the pointer" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un zoom en el cabezal de reproducción que sigue al puntero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un zoom à la tête de lecture, qui suit le pointeur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生ヘッド位置にポインタを追うズームを追加"
