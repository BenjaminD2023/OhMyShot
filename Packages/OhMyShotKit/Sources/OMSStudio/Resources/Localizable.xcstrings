    "No clicks or typing to follow, so no zooms were placed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay clics ni escritura que seguir, así que no se ha colocado ningún zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun clic ni aucune saisie à suivre : aucun zoom n’a donc été placé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追跡するクリックや入力がないため、ズームは配置されませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可跟随的点按或输入，因此未添加缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可跟隨的點按或輸入，因此未加入縮放。"
          }
        }
      }
    },
    "No clicks to follow, so no zooms were placed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay clics que seguir, así que no se ha colocado ningún zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun clic à suivre : aucun zoom n’a donc été placé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追跡するクリックがないため、ズームは配置されませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可跟随的点按，因此未添加缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可跟隨的點按，因此未加入縮放。"
          }
        }
      }
    },
    "No keys were kept with this recording. Studio keeps them when Input Monitoring is on and Settings allows it (a window recorded on its own, only with Show Keystrokes on)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han guardado teclas con esta grabación. Studio las guarda cuando la monitorización de entrada está activada y los Ajustes lo permiten (en una ventana grabada por sí sola, solo con “Mostrar pulsaciones de teclas” activado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune touche n’a été conservée avec cet enregistrement. Studio les conserve lorsque la surveillance de l’entrée est activée et que les réglages l’autorisent (pour une fenêtre enregistrée seule, uniquement si Afficher les touches est activé)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この収録ではキーが記録されていません。スタジオは、入力監視がオンで「設定」で許可されている場合にキーを記録します（単独で収録したウインドウでは、「キー操作を表示」がオンの場合のみ）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此录制未保存任何按键。当“输入监控”已打开且“设置”允许时，Studio 会保存按键（单独录制的窗口仅在打开“显示按键”时保存）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此錄影未保留任何按鍵。當「輸入監控」已開啟且「設定」允許時，Studio 才會保留按鍵（單獨錄製的視窗僅在開啟「顯示按鍵」時保留）。"
          }
        }
      }
    },
    "No room for a zoom at the playhead: move it past the zooms there" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay sitio para un zoom en el cabezal: llévalo más allá de los zooms que hay ahí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de place pour un zoom à la tête de lecture : placez-la après les zooms qui s’y trouvent"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生ヘッドの位置にズームを置く余地がありません。そこにあるズームの後ろへ移動してください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放头处没有放缩放的空间：把播放头移到那里的缩放之后"
