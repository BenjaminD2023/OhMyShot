    "What you typed is kept with this recording, on this Mac. Settings › Recording can keep shortcuts only, or no keys." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribiste se guarda con esta grabación, en este Mac. En Ajustes › Grabación puedes guardar solo los atajos o ninguna tecla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous avez tapé est conservé avec cet enregistrement, sur ce Mac. Réglages › Enregistrement permet de ne conserver que les raccourcis, ou aucune touche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力した内容は、この収録とともにこのMacに保存されます。「設定」›「収録」で、ショートカットのみを保存するか、キーを保存しないように設定できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你输入的内容会随此录制保存在这台 Mac 上。可在“设置 › 录制”中改为仅保存快捷键，或不保存按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你輸入的內容會與此錄影一起保存在這台 Mac 上。在「設定」›「錄製」中可設為僅保留快速鍵，或不保留任何按鍵。"
          }
        }
      }
    },
