    "Click or drag on the preview to aim the zoom. With the preview focused, the arrow keys move it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic o arrastra en la previsualización para apuntar el zoom. Con la previsualización enfocada, las teclas de flecha lo mueven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez ou faites glisser sur l’aperçu pour viser avec le zoom. Quand l’aperçu est actif, les touches fléchées le déplacent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューをクリックまたはドラッグしてズームの位置を決めます。プレビューにフォーカスがあるときは、矢印キーで動かせます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在预览上点按或拖移以对准缩放位置。预览获得焦点时，可用箭头键移动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在預覽上按一下或拖移以對準縮放位置。預覽取得焦點時，可用方向鍵移動它。"
          }
        }
      }
    },
