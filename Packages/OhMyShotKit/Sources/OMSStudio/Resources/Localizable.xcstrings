    "Add Layout shows the camera another way for a stretch of the movie." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Añadir disposición” muestra la cámara de otra forma durante un tramo de la película."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter une disposition affiche la caméra autrement pendant une partie de la vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「レイアウトを追加」では、ムービーの一定区間でカメラ映像を別の方法で表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“添加布局”可在影片的某一段中以另一种方式显示摄像头画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「加入版面配置」可在影片的某一段以其他方式顯示相機畫面。"
          }
        }
      }
    },
