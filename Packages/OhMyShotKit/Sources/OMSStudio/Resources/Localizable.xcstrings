    "← and → move the playhead. Option-← and Option-→ choose an edit. I and O mark a range; Delete removes it. Scroll to move along a zoomed timeline." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "← y → mueven el cabezal. Option-← y Option-→ eligen una edición. I y O marcan un intervalo; Delete lo elimina. Desplázate por la línea de tiempo ampliada con el scroll."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "← et → déplacent la tête de lecture. Option-← et Option-→ choisissent une modification. I et O délimitent une plage ; Delete la retire. Faites défiler la timeline agrandie pour vous déplacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "← と → で再生ヘッドを移動します。Option-← と Option-→ で編集を選択します。I と O で範囲を指定し、Delete で取り除きます。拡大したタイムラインはスクロールで移動できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "← 和 → 移动播放头。Option-← 和 Option-→ 选择编辑对象。I 和 O 标记范围；Delete 移除所选内容。滚动可在放大的时间线上移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "← 和 → 移動播放頭。Option-← 和 Option-→ 選擇編輯物件。I 和 O 標記範圍；Delete 移除所選內容。捲動可在放大的時間列上移動。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
