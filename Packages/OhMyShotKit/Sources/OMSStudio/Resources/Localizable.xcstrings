    "The camera couldn’t be recorded." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido grabar la cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer la caméra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラを収録できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法录制摄像头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法錄製相機畫面。"
          }
        }
      }
    },
    "The clicks and typing were too few or too spread out to zoom on. Add Zoom places one by hand." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clics y la escritura eran demasiado escasos o estaban demasiado dispersos para hacer zoom. “Añadir zoom” coloca uno a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clics et la saisie étaient trop rares ou trop dispersés pour zoomer. Ajouter un zoom permet d’en placer un manuellement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックや入力が少なすぎるか、間隔が空きすぎているため、ズームできませんでした。「ズームを追加」で手動で配置できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按和输入太少或太分散，无法缩放。可使用“添加缩放”手动放置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按和輸入太少或太分散，無法縮放。可使用「加入縮放」手動加入。"
          }
        }
      }
    },
